{
  "name": "lg-report-agent",
  "version": "1.0.3",
  "description": "LG전자 내부 사용자를 위한 로컬 우선 보고서 작성 데스크톱 애플리케이션",
  "private": true,
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "assets:icon": "node scripts/create-icon.mjs",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "npm run build && playwright test",
    "test:e2e:packaged": "node scripts/run-packaged-e2e.mjs",
    "test:integration:codex": "vitest run tests/codex-smoke --passWithNoTests",
    "build": "electron-vite build",
    "build:win": "npm run build && node scripts/build-win.mjs && npm run check:package-size",
    "check:package-size": "node scripts/check-package-size.mjs",
    "check:release-signing": "node scripts/check-code-signing.mjs",
    "verify:release-signatures": "node scripts/verify-release-signatures.mjs",
    "verify:electron-fuses": "node scripts/check-electron-fuses.mjs",
    "release:checksums": "node scripts/create-release-checksums.mjs",
    "release:verify": "node scripts/verify-release-assets.mjs",
    "release:sbom": "node scripts/generate-sbom.mjs",
    "licenses:production": "node scripts/generate-production-licenses.mjs",
    "release:metadata": "npm run release:sbom && npm run licenses:production",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm run test && npm run test:integration && npm run build",
    "postinstall": "node scripts/install-native.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SWBaek/lg-report-gen.git"
  },
  "keywords": [],
  "author": "Internal Tools",
  "license": "UNLICENSED",
  "type": "module",
  "bugs": {
    "url": "https://github.com/SWBaek/lg-report-gen/issues"
  },
  "homepage": "https://github.com/SWBaek/lg-report-gen#readme",
  "build": {
    "appId": "com.internal.lgreportagent",
    "productName": "LG Report Agent",
    "asar": true,
    "compression": "normal",
    "electronLanguages": [
      "ko",
      "en-US"
    ],
    "npmRebuild": false,
    "forceCodeSigning": true,
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "loadBrowserProcessSpecificV8Snapshot": false,
      "grantFileProtocolExtraPrivileges": true
    },
    "electronDist": "node_modules/electron/dist",
    "asarUnpack": [
      "node_modules/better-sqlite3/native/better_sqlite3-electron.node"
    ],
    "directories": {
      "output": "release-artifacts",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "package.json",
      "!node_modules/**/*.map",
      "!node_modules/**/*.md",
      "!node_modules/**/README*",
      "!node_modules/better-sqlite3/build/**/*",
      "!node_modules/better-sqlite3/deps/**/*",
      "!node_modules/better-sqlite3/src/**/*",
      "!node_modules/better-sqlite3/native/better_sqlite3.node"
    ],
    "win": {
      "target": [
        "portable",
        "nsis"
      ],
      "requestedExecutionLevel": "asInvoker",
      "icon": "build/icon.ico"
    },
    "portable": {
      "artifactName": "LG-Report-Agent-${version}-x64-Portable.exe"
    },
    "nsis": {
      "artifactName": "LG-Report-Agent-Setup-${version}-x64.exe",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "dependencies": {
    "@napi-rs/canvas": "^1.0.8",
    "better-sqlite3": "^12.11.1",
    "htmlparser2": "^12.0.0"
  },
  "devDependencies": {
    "@electron/fuses": "^1.8.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-tabs": "^1.1.21",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@tiptap/extension-image": "^3.31.0",
    "@tiptap/extension-link": "^3.31.0",
    "@tiptap/extension-table": "^3.31.0",
    "@tiptap/extension-table-cell": "^3.31.0",
    "@tiptap/extension-table-header": "^3.31.0",
    "@tiptap/extension-table-row": "^3.31.0",
    "@tiptap/extension-text-align": "^3.31.0",
    "@tiptap/extension-underline": "^3.31.0",
    "@tiptap/react": "^3.31.0",
    "@tiptap/starter-kit": "^3.31.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/cross-spawn": "^6.0.6",
    "@types/diff": "^7.0.2",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@types/sanitize-html": "^2.16.1",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^4.1.11",
    "cross-spawn": "^7.0.6",
    "csv-parse": "^7.0.2",
    "diff": "^9.0.0",
    "dompurify": "^3.4.14",
    "electron": "^42.11.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.5",
    "exceljs": "^4.4.0",
    "jsdom": "^30.0.1",
    "jszip": "^3.10.1",
    "lucide-react": "^1.39.0",
    "mammoth": "^1.12.2",
    "marked": "^18.0.11",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.3.289",
    "playwright": "^1.62.1",
    "png-to-ico": "^3.0.2",
    "pretendard": "^1.3.9",
    "prettier": "^3.9.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sanitize-html": "^2.17.7",
    "sharp": "^0.35.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^7.3.6",
    "vitest": "^4.1.11",
    "zod": "^4.5.4"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
